---
import PageView from "../components/PageView.astro";
import { pages } from "../content/pages";
import { route, type Locale } from "../data/site";
import type { Page } from "../content/types";

export function getStaticPaths() {
  const locale: Locale = "fr";
  return Object.entries(pages[locale]).map(([slug, page]) => {
    const expected = route(locale, page.id).replace(/^\/|\/$/g, "");
    if (slug !== expected) {
      throw new Error(`FR slug "${slug}" does not match route "${expected}" for ${page.id}`);
    }
    return { params: { slug }, props: { page } };
  });
}

interface Props {
  page: Page;
}

const { page } = Astro.props;
---

<PageView locale="fr" page={page} />
